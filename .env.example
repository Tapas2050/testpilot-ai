# Backend Database & Cache
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/testpilot
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/testpilot_test
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/1

# Security & Storage
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
CREDENTIAL_ENCRYPTION_KEY=
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10
ALLOWED_PRIVATE_HOSTS=localhost,127.0.0.1

# LLM Providers
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.5-flash-lite
GOOGLE_FALLBACK_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
LLM_MAX_RETRIES=3
LLM_REQUESTS_PER_MINUTE=12
LLM_REQUEST_TIMEOUT_SECONDS=60

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Agent Limits
MAX_TESTS_PER_RUN=8
MAX_STEPS_PER_TEST=15
TEST_TIMEOUT_SECONDS=120
RUN_TIMEOUT_SECONDS=1800

# SupportDesk (demo target)
SUPPORTDESK_URL=http://localhost:8001
SUPPORTDESK_DEFECTS=on
SUPPORTDESK_ADMIN_EMAIL=admin@supportdesk.local
SUPPORTDESK_ADMIN_PASSWORD=
SUPPORTDESK_AGENT_EMAIL=agent@supportdesk.local
SUPPORTDESK_AGENT_PASSWORD=
