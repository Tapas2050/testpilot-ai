# CI Environment Profile for Automated Testing & GitHub Actions
# Used by containerized test jobs and reproducible CI runs

# Database configuration (Postgres service container)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/testpilot
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/testpilot_test

# Redis configuration (Redis service container)
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/1

# Security and Cryptography Secrets (CI testing profile)
JWT_SECRET=ci-jwt-secret-testing-minimum-32-characters-required
ENCRYPTION_KEY=dXNlci1lbmNyeXB0aW9uLWtleS0zMi1ieXRlcy1iYXNlNjQ=

# Target Application URL (SupportDesk testbed)
SUPPORTDESK_URL=http://localhost:8001

# LLM Providers (Mocked during CI unit and integration testing)
GEMINI_API_KEY=dummy-ci-gemini-key
OPENROUTER_API_KEY=dummy-ci-openrouter-key

# Storage & Screenshot retention
SCREENSHOT_RETENTION_DAYS=1
LOG_LEVEL=INFO
